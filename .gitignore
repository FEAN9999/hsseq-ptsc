.design-sync/learnings/
.design-sync/node_modules
frontend/.ds-tw-entry.css
frontend/.ds-compiled-tw.css
frontend/.ds-compiled.css
frontend/.ds-tsconfig.json
# Khai báo kiểu sinh bởi .design-sync/tsconfig.ds.json
frontend/.ds-types/
frontend/index.d.ts
# File tạm của build-styles.mjs — chỉ còn lại nếu tiến trình bị giết giữa chừng
frontend/src/styles/.ds-entry.css
# .ds-entry.tsx CÓ commit: nó là danh sách component của design system, mất nó
# thì bản clone mới không sync lại được. (Trước đây bị bỏ qua vì chỉ là entry rỗng.)
!frontend/.ds-entry.tsx
design-drafts/

# graphify — knowledge graph artifacts (sinh lại được bằng `/graphify .`)
# Ignore sạch, giống repo của chính tác giả graphify. README upstream khuyên
# commit để chia sẻ cho team, nhưng ở đây là công cụ cá nhân nên không cần.
# .graphify_python / .graphify_root chứa ĐƯỜNG DẪN TUYỆT ĐỐI của máy — luôn phải ignore.
graphify-out/
.graphify_*.json
.graphify_python
