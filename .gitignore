# Playwright artifacts
# anh/ là ảnh chụp màn do e2e/anh-man-hinh.spec.ts sinh ra để soi thiết kế —
# công cụ, không phải sản phẩm.
frontend/anh/
**/test-results/
**/playwright-report/
**/playwright/.cache/
tests/e2e/critical-report.json
tests/e2e/noncritical-report.json

# Environment variables — cấu hình nằm ở env/local/ và env/production/.
# Chỉ backend.env chứa bí mật thật. Mọi tệp env còn lại trong env/ đều commit:
# *.example là mẫu, backend.thu-tai-cho.env là giá trị GIẢ để `make prod-len`
# chạy được ngay trên bản clone mới, còn frontend.env vốn công khai vì biến
# VITE_* nằm sẵn trong bundle JS.
env/**/backend.env

# Lưới an toàn. Cấu trúc mới không sinh ra tệp nào dạng .env — mấy dòng này chỉ
# để một tệp bỏ quên (hay thói quen cũ) không lọt vào history.
.env
.env.*
.envrc
env/**/backend.env

# Seed danh sách hội viên: tệp này nhúng thẳng họ tên, ngày sinh, số điện thoại
# của 126 người thật để dựng chỗ ở tạm (docs/host-tam-windows.md bước 7). History
# của git không xoá được, nên nó phải ở ngoài repo — chép sang máy khác bằng USB
# hay kênh riêng.
backend/scripts/seed_hoi_vien.py

# Thư mục vào của scripts/nap_anh_dai_dien.py: ảnh chân dung hội viên, cùng loại
# dữ liệu cá nhân với tệp trên và cùng lý do phải nằm ngoài history.
backend/scripts/anh_dai_dien/

# Nguồn Excel của danh mục FM01. Danh mục đã được TRÍCH một lần sang
# backend/app/seed/catalog_fm01.py (nguồn chân lý của code); file .xlsx chỉ
# còn là tài liệu gốc để đối chiếu bằng mắt, không code nào và không test nào
# đọc nó. Nặng, nhị phân, diff vô nghĩa — giữ ngoài history (plan Task 6 dòng
# 44 đã tự chỉ định điều này).
backend/app/seed/source/

# Local secrets / certs
*.pem
*.key
*.crt
*.p12
# Hai thư mục stack prod dựng tại chỗ tự sinh ra. Cert tự ký đã bị *.pem bắt,
# nhưng chặn cả thư mục để lỡ có tệp định dạng khác thì cũng không lọt.
deploy/certs-local/
deploy/certbot-www/

# AI / Agent tooling
# ─────────────────────────────────────────────
# .claude/ and .specify/ contain skills/templates that are safe to commit.
# Only ignore per-user / sensitive runtime configs:
.claude/settings.local.json
.specify/init-options.json
.specify/integration.json
